# One file for both ways of running this: `npm start` reads it directly, and
# docker compose passes it into the container. The few settings that describe
# the container itself (DATA_DIR, WEB_ROOT, PORT, HOST, the browser profile) are
# set in docker-compose.yml and override what is here, so the values below stay
# correct for running from a checkout.

# Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# Reached over HTTPS, directly or through a TLS proxy. Adds the security headers
# a browser only honours on a trusted origin. Leave false for plain HTTP on a
# LAN, or the page tells itself to load its own assets over HTTPS and breaks.
HTTPS=false

# Storage
DATA_DIR=./data

# Collector
COLLECT_INTERVAL_MINUTES=360

COLLECT_ENABLED_SOURCES=kleinanzeigen,autoscout24,autouncle
COLLECT_MAX_PAGES=6
COLLECT_STORE_PHOTOS=true
COLLECT_TIMEOUT_MS=15000
COLLECT_MIN_HOST_INTERVAL_MS=2500
COLLECT_DEADLINE_MS=300000
FX_BASE=EUR

# Headless browser (auto = only for sources that need one)
COLLECT_BROWSER=auto
# Set to 'chrome' to use real Chrome rather than bundled Chromium
#COLLECT_BROWSER_CHANNEL=
COLLECT_BROWSER_HEADLESS=true
COLLECT_BROWSER_SETTLE_MS=1500
COLLECT_LOCALE=de-DE
COLLECT_SOURCE_DEADLINE_MS=60000
COLLECT_PHOTO_BUDGET_MB=2000
COLLECT_TIMEZONE=Europe/Berlin
# Writes the markup and a screenshot of every fetch to DATA_DIR/debug
COLLECT_BROWSER_DEBUG=false
COLLECT_CONCURRENCY=3

# If a portal refuses a synthesised browser, drive a real one instead.
# A profile warmed up once by hand, reused from then on (works in Docker):
#COLLECT_BROWSER_PROFILE_DIR=
# Or attach to a browser you already run: chrome --remote-debugging-port=9222
#COLLECT_BROWSER_CDP=

# Fingerprint patching. `off` lets Chrome be Chrome, which passes more checks
# than a patched one because each patch is itself detectable.
COLLECT_BROWSER_STEALTH=off
COLLECT_BROWSER_BLOCK_ASSETS=true
# Detail pages cost about seven seconds each. Photos come from the list page, so
# this only buys the full advert text instead of the 250-character teaser.
COLLECT_MAX_DETAILS=0
COLLECT_ASSET_INTERVAL_MS=150

# Debugging a run: every browser step recorded to DATA_DIR/traces/*.zip,
# openable with `npx playwright show-trace <file>`. Slow-mo pairs with
# COLLECT_BROWSER_HEADLESS=false to watch it live.
COLLECT_BROWSER_TRACE=false
COLLECT_BROWSER_SLOWMO_MS=0
COLLECT_DEBUG_KEEP=50

# Challenge solver (Byparr or FlareSolverr). Cloudflare's interstitial can be
# passed; delegating that keeps it out of this codebase. Unset means no solver,
# and the affected sources fall back to the browser.
#
# The solver drives a full browser per call, which is slow, so its result is
# reused: the cookies and user agent that cleared a host are replayed over plain
# fetch for later pages, and the solver is only asked again once that clearance
# ages out or the portal stops honouring it. This is the point of running a
# solver rather than a browser per request — the cookies are its actual output.
#
# Pick one:
#   the bundled container, started with `docker compose --profile solver up -d`
#COLLECT_SOLVER_URL=http://byparr:8191/v1
#   one already running elsewhere, an LXC or another machine
#COLLECT_SOLVER_URL=http://192.168.2.41:8191/v1
#   one on the Docker host itself
#COLLECT_SOLVER_URL=http://host.docker.internal:8191/v1
#   running from a checkout rather than in a container
#COLLECT_SOLVER_URL=http://127.0.0.1:8191/v1
COLLECT_SOLVER_SOURCES=autouncle
COLLECT_SOLVER_TIMEOUT_MS=60000
# How long a solved host's clearance is replayed before the solver is asked
# again. Kept below Cloudflare's own clearance lifetime so a replay lands while
# the cookie is still valid; a replay that is refused re-solves at once anyway.
COLLECT_SOLVER_CLEARANCE_TTL_MS=1800000

# The clearance replay reuses the solver's IP path implicitly: Byparr and the app
# must share a public IP (the usual homelab case) for the cleared cookie to be
# accepted from here. If they do not, the replay is refused and the solver is
# used every time — correct, just without the saving.

# ---------------------------------------------------------------------------
# docker compose only. The app never reads these; they decide how the container
# is published and where its volume lives.
# ---------------------------------------------------------------------------

# Host port for the web interface.
CARSCOPE_PORT=8080
# Host path mounted at /data: database, photos, browser profile. Nothing needs
# preparing; the container takes ownership of it on start.
CARSCOPE_DATA=./data

# Who the files belong to afterwards. Set these to `id -u` and `id -g` if they
# should be yours rather than uid 1000.
#CARSCOPE_UID=1000
#CARSCOPE_GID=1000
#CARSCOPE_SHM_SIZE=512mb

# Only used with `--profile solver`. The bundled solver binds to loopback so it
# is reachable for debugging without being exposed to the network.
#BYPARR_PORT=127.0.0.1:8191
#BYPARR_IMAGE=ghcr.io/thephaseless/byparr:latest
#BYPARR_SHM_SIZE=512mb
